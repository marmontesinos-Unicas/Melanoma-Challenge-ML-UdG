    "   },\n",
    "   \"source\": [\n",
    "    \"if RUN_ABLATION:\\n\",\n",
    "    \"    fams = [f for f in USE_FAMILIES if (FAMILY == f).any()]\\n\",\n",
    "    \"    sets = {\\\"todas\\\": feat}\\n\",\n",
    "    \"    for f in fams:\\n\",\n",
    "    \"        sets[f\\\"solo {f}\\\"] = list(FAMILY.index[FAMILY == f])\\n\",\n",
    "    \"    for f in fams:\\n\",\n",
    "    \"        sets[f\\\"sin {f}\\\"] = list(FAMILY.index[FAMILY != f])\\n\",\n",
    "    \"    sets[\\\"solo lesión (shape+color+tex)\\\"] = list(FAMILY.index[FAMILY.isin([\\\"shape\\\", \\\"color\\\", \\\"tex\\\"])])\\n\",\n",
    "    \"    sets[\\\"solo imagen entera (gcolor+gtex)\\\"] = list(FAMILY.index[FAMILY.isin([\\\"gcolor\\\", \\\"gtex\\\"])])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    kinds_abl = {KIND[ABLATION_MODEL]}\\n\",\n",
    "    \"    rows = {}\\n\",\n",
    "    \"    t0 = time.time()\\n\",\n",
    "    \"    for nm, cols in sets.items():\\n\",\n",
    "    \"        if not cols:\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"        idx = [feat.index(c) for c in cols]\\n\",\n",
    "    \"        Pa = oof_from_folds(ABLATION_MODEL, make_folds(Xtr_np[:, idx], y_tr, kinds_abl), y_tr, rf_trees=ABLATION_TREES)\\n\",\n",
    "    \"        m = evaluate(y_tr, Pa)\\n\",\n",
    "    \"        rows[nm] = {\\\"nº features\\\": len(cols),\\n\",\n",
    "    \"                    \\\"CV kappa (argmax)\\\": m[\\\"Kappa\\\"],\\n\",\n",
    "    \"                    \\\"CV kappa (pesos aj.)\\\": crossfit_kappa(Pa, y_tr) if TUNE_CLASS_WEIGHTS else m[\\\"Kappa\\\"],\\n\",\n",
    "    \"                    \\\"CV F1 macro\\\": m[\\\"F1 macro\\\"], \\\"CV Bal.acc\\\": m[\\\"Bal. acc\\\"], f\\\"recall {CLASSES[1]}\\\": m[f\\\"recall {CLASSES[1]}\\\"]}\\n\",\n",
    "    \"    ablation = pd.DataFrame(rows).T.sort_values(SELECT_COL, ascending=False)\\n\",\n",
    "    \"    print(f\\\"Ablación con {ABLATION_MODEL} (CV en train, {len(y_tr)} imágenes, {time.time() - t0:.0f}s)\\\")\\n\",\n",
    "    \"    display(ablation.round(3))\"\n",
