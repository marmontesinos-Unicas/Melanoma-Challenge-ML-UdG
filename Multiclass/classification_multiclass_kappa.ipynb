    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"W = {n: (tune_class_weights(P_oof[n], y_tr) if TUNE_CLASS_WEIGHTS and n != \\\"baseline\\\" else np.ones(K)) for n in P_oof}\\n\",\n",
    "    \"\\n\",\n",
    "    \"rows = {}\\n\",\n",
    "    \"for n in P_oof:\\n\",\n",
    "    \"    cv0, cv1 = evaluate(y_tr, P_oof[n]), evaluate(y_tr, P_oof[n], W[n])\\n\",\n",
    "    \"    v0, v1 = evaluate(y_va, P_va[n]), evaluate(y_va, P_va[n], W[n])\\n\",\n",
    "    \"    rows[n] = {\\\"CV kappa (argmax)\\\": cv0[\\\"Kappa\\\"],\\n\",\n",
    "    \"               \\\"CV kappa (pesos aj.)\\\": crossfit_kappa(P_oof[n], y_tr) if TUNE_CLASS_WEIGHTS and n != \\\"baseline\\\" else cv0[\\\"Kappa\\\"],\\n\",\n",
    "    \"               \\\"CV F1 macro\\\": cv0[\\\"F1 macro\\\"], \\\"CV PR-AUC (info)\\\": cv0[\\\"PR-AUC macro (info)\\\"],\\n\",\n",
    "    \"               \\\"VAL kappa (argmax)\\\": v0[\\\"Kappa\\\"], \\\"VAL kappa (pesos aj.)\\\": v1[\\\"Kappa\\\"],\\n\",\n",
    "    \"               \\\"VAL F1 macro (aj.)\\\": v1[\\\"F1 macro\\\"], \\\"VAL Bal.acc (aj.)\\\": v1[\\\"Bal. acc\\\"], \\\"VAL MCC (aj.)\\\": v1[\\\"MCC\\\"],\\n\",\n",
    "    \"               \\\"VAL PR-AUC (info)\\\": v0[\\\"PR-AUC macro (info)\\\"], \\\"VAL ROC-AUC (info)\\\": v0[\\\"ROC-AUC macro (info)\\\"],\\n\",\n",
    "    \"               \\\"VAL Accuracy (info)\\\": v0[\\\"Accuracy (info)\\\"]}\\n\",\n",
    "    \"SELECT_COL = \\\"CV kappa (pesos aj.)\\\" if TUNE_CLASS_WEIGHTS else \\\"CV kappa (argmax)\\\"\\n\",\n",
    "    \"summary = pd.DataFrame(rows).T.sort_values(SELECT_COL, ascending=False)\\n\",\n",
    "    \"\\n\",\n",
    "    \"best = next(n for n in summary.index if n != \\\"baseline\\\")      # mejor modelo según kappa en CV (no según val)\\n\",\n",
    "    \"print(f\\\"Mejor modelo por {SELECT_COL}: {best}  ({summary.loc[best, SELECT_COL]:.3f})\\\\n\\\")\\n\",\n",
    "    \"display(summary.round(3))\\n\",\n",
    "    \"print(\\\"Pesos por clase ajustados (\\\", CLASSES, \\\"):\\\")\\n\",\n",
    "    \"for n in summary.index:\\n\",\n",
    "    \"    print(f\\\"  {n:9s}\\\", np.round(W[n], 2))\"\n",
    "   ],\n",
