    "   \"source\": [\n",
    "    \"# Detalle por clase del mejor modelo en val (con los pesos ajustados)\\n\",\n",
    "    \"P, w = P_va[best], W[best]\\n\",\n",
    "    \"pred = (P * w).argmax(1)\\n\",\n",
    "    \"Y = label_binarize(y_va, classes=np.arange(K))\\n\",\n",
    "    \"prec, rec, f1, sup = precision_recall_fscore_support(y_va, pred, labels=np.arange(K), zero_division=0)\\n\",\n",
    "    \"per_class = pd.DataFrame({\\\"soporte\\\": sup, \\\"prevalencia\\\": Y.mean(0),\\n\",\n",
    "    \"                          \\\"AP (PR-AUC)\\\": [average_precision_score(Y[:, k], P[:, k]) for k in range(K)],\\n\",\n",
    "    \"                          \\\"precision\\\": prec, \\\"recall\\\": rec, \\\"F1\\\": f1}, index=CLASSES)\\n\",\n",
    "    \"per_class[\\\"AP / prevalencia\\\"] = per_class[\\\"AP (PR-AUC)\\\"] / per_class[\\\"prevalencia\\\"]\\n\",\n",
    "    \"print(f\\\"Modelo: {best} | val ({len(y_va)} imágenes) | kappa val = {kappa(y_va, pred):.3f}\\\")\\n\",\n",
    "    \"display(per_class.round(3))\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def plot_pr_curves(P, y, title):\\n\",\n",
    "    \"    Y = label_binarize(y, classes=np.arange(K))\\n\",\n",
    "    \"    fig, ax = plt.subplots(figsize=(6, 5))\\n\",\n",
    "    \"    for k, c in enumerate(CLASSES):\\n\",\n",
    "    \"        p, r, _ = precision_recall_curve(Y[:, k], P[:, k])\\n\",\n",
    "    \"        line, = ax.plot(r, p, label=f\\\"{c}  AP={average_precision_score(Y[:, k], P[:, k]):.2f}  (azar={Y[:, k].mean():.2f})\\\")\\n\",\n",
    "    \"        ax.axhline(Y[:, k].mean(), ls=\\\"--\\\", lw=0.8, color=line.get_color())\\n\",\n",
    "    \"    ax.set(xlabel=\\\"Recall\\\", ylabel=\\\"Precision\\\", title=title, xlim=(0, 1), ylim=(0, 1.02))\\n\",\n",
    "    \"    ax.legend(loc=\\\"lower left\\\", fontsize=8)\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def plot_confusions(y, pred, title):\\n\",\n",
    "    \"    cm = confusion_matrix(y, pred, labels=np.arange(K))\\n\",\n",
    "    \"    cmn = cm / cm.sum(1, keepdims=True).clip(1)\\n\",\n",
    "    \"    fig, axs = plt.subplots(1, 2, figsize=(10, 4))\\n\",\n",
    "    \"    for ax, M, fmt, t in [(axs[0], cm, \\\"d\\\", \\\"Conteos\\\"), (axs[1], cmn, \\\".2f\\\", \\\"Normalizada por fila (= recall)\\\")]:\\n\",\n",
    "    \"        ax.imshow(M, cmap=\\\"Blues\\\", vmin=0, vmax=None if fmt == \\\"d\\\" else 1)\\n\",\n",
    "    \"        for i in range(K):\\n\",\n",
    "    \"            for j in range(K):\\n\",\n",
    "    \"                ax.text(j, i, format(M[i, j], fmt), ha=\\\"center\\\", va=\\\"center\\\",\\n\",\n",
    "    \"                        color=\\\"white\\\" if M[i, j] > M.max() * 0.6 else \\\"black\\\")\\n\",\n",
    "    \"        ax.set(xticks=range(K), yticks=range(K), xticklabels=CLASSES, yticklabels=CLASSES,\\n\",\n",
    "    \"               xlabel=\\\"Predicha\\\", ylabel=\\\"Real\\\", title=t)\\n\",\n",
    "    \"    fig.suptitle(title)\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"plot_pr_curves(P_va[best], y_va, f\\\"Curvas PR en val · {best} (líneas discontinuas = prevalencia)\\\")\\n\",\n",
    "    \"plot_confusions(y_va, pred, f\\\"Matriz de confusión en val · {best} (pesos ajustados)\\\")\"\n",
