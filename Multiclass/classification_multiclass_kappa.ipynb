    "    \"\\n\",\n",
    "    \"warnings.filterwarnings(\\\"ignore\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ---------------- Configuración ----------------\\n\",\n",
    "    \"ROOT = Path(r\\\"C:\\\\Users\\\\Lenovo\\\\PycharmProjects\\\\Melanoma-Challenge-ML-UdG\\\")\\n\",\n",
    "    \"FEAT_DIR = ROOT / \\\"features_multiclass\\\"          # salida de feature_extraction_multiclass\\n\",\n",
    "    \"OUT_DIR = ROOT / \\\"results_multiclass_kappa\\\"      # resultados de este notebook (carpeta nueva)\\n\",\n",
    "    \"CACHE_DIR = OUT_DIR / \\\"cache\\\"                    # resultados parciales por modelo\\n\",\n",
    "    \"CLASSES = [\\\"bcc\\\", \\\"mel\\\", \\\"scc\\\"]                  # el orden define el índice de cada clase (0, 1, 2)\\n\",\n",
    "    \"CLASS_TO_LABEL = {c: i for i, c in enumerate(CLASSES)}\\n\",\n",
    "    \"\\n\",\n",
    "    \"N_TRAIN = None           # nº de imágenes de train (estratificado por clase). None = todas\\n\",\n",
    "    \"N_VAL = None             # nº de imágenes de val   (estratificado por clase). None = todas\\n\",\n",
    "    \"SEED = 42\\n\",\n",
    "    \"CV_FOLDS = 5\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Núcleos: TODOS MENOS 2. Si el portátil se calienta o va muy lento, baja este número (p. ej. a 4 o a la mitad de los núcleos).\\n\",\n",
    "    \"N_JOBS = max(1, (os.cpu_count() or 4) - 2)\\n\",\n",
    "    \"threadpool_limits(N_JOBS)                        # limita también BLAS / OpenMP (boosting, regresión logística)\\n\",\n",
    "    \"\\n\",\n",
    "    \"KAPPA_WEIGHTS = None     # None = kappa de Cohen sin pesos; \\\"linear\\\" / \\\"quadratic\\\" = ponderado (solo para clases ordenadas)\\n\",\n",
    "    \"\\n\",\n",
    "    \"MODELS_TO_RUN = [\\\"logreg\\\", \\\"svm\\\", \\\"rf\\\", \\\"hgb\\\"]   # ver make_model()\\n\",\n",
    "    \"USE_ENSEMBLE = True      # media de probabilidades de los modelos de arriba\\n\",\n",
    "    \"TUNE_CLASS_WEIGHTS = True    # multiplicadores por clase sobre las probabilidades OOF (maximizan el kappa)\\n\",\n",
    "    \"RUN_ABLATION = False     # ablación por familias de features\\n\",\n",
    "    \"ABLATION_MODEL = \\\"rf\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"USE_FAMILIES = [\\\"shape\\\", \\\"color\\\", \\\"tex\\\", \\\"gcolor\\\", \\\"gtex\\\"]   # familias de features a usar\\n\",\n",
    "    \"PREFIX = {\\\"shape\\\": \\\"shape_\\\", \\\"color\\\": \\\"color_\\\", \\\"tex\\\": \\\"tex_\\\", \\\"gcolor\\\": \\\"gcolor_\\\", \\\"gtex\\\": \\\"gtex_\\\"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"CORR_THRESHOLD = 0.98    # quita features casi duplicadas (|correlación| > umbral, con train). None = no quitar\\n\",\n",
    "    \"RF_TREES = 300\\n\",\n",
    "    \"ABLATION_TREES = 100     # árboles del RF en la ablación (más rápido)\\n\",\n",
    "    \"SVM_PROBABILITY = False  # True = SVC(probability=True): probabilidades calibradas pero ~5x más lento\\n\",\n",
    "    \"SVM_TEMP = 3.0           # temperatura del softmax sobre las puntuaciones del SVM (si SVM_PROBABILITY = False)\\n\",\n",
    "    \"USE_CACHE = True         # guarda y reutiliza el resultado de cada modelo en CACHE_DIR\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Núcleos disponibles: {os.cpu_count()} | en uso (N_JOBS): {N_JOBS}\\\")\"\n",
    "   ],\n",
