    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"968bcc68\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Carga y submuestra estratificada (misma proporción de clases que el dataset completo)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"837f291f\",\n",
    "   \"metadata\": {\n",
    "    \"lines_to_next_cell\": 1,\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-21T06:32:57.261443800Z\",\n",
    "     \"start_time\": \"2026-10-21T06:32:56.644371500Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"def allocate(counts, n):\\n\",\n",
    "    \"    \\\"\\\"\\\"Reparto proporcional (método del mayor resto) que suma exactamente n.\\\"\\\"\\\"\\n\",\n",
    "    \"    total = sum(counts.values())\\n\",\n",
    "    \"    exact = {k: n * v / total for k, v in counts.items()}\\n\",\n",
    "    \"    alloc = {k: int(np.floor(v)) for k, v in exact.items()}\\n\",\n",
    "    \"    rest = n - sum(alloc.values())\\n\",\n",
    "    \"    for k in sorted(exact, key=lambda k: exact[k] - alloc[k], reverse=True)[:rest]:\\n\",\n",
    "    \"        alloc[k] += 1\\n\",\n",
    "    \"    return alloc\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def stratified_subsample(df, n, seed):\\n\",\n",
    "    \"    \\\"\\\"\\\"Submuestra de n filas conservando la proporción de cada clase.\\\"\\\"\\\"\\n\",\n",
    "    \"    if n is None or n >= len(df):\\n\",\n",
    "    \"        return df.copy()\\n\",\n",
    "    \"    alloc = allocate(df[\\\"class\\\"].value_counts().to_dict(), n)\\n\",\n",
    "    \"    parts = [g.sample(n=alloc[c], random_state=seed) for c, g in df.groupby(\\\"class\\\")]\\n\",\n",
    "    \"    return pd.concat(parts).sample(frac=1, random_state=seed).reset_index(drop=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def class_table(full, sample, title):\\n\",\n",
    "    \"    a = full[\\\"class\\\"].value_counts().reindex(CLASSES).fillna(0).astype(int)\\n\",\n",
    "    \"    b = sample[\\\"class\\\"].value_counts().reindex(CLASSES).fillna(0).astype(int)\\n\",\n",
    "    \"    t = pd.DataFrame({\\\"completo\\\": a, \\\"% completo\\\": (100 * a / a.sum()).round(2),\\n\",\n",
    "    \"                      \\\"muestra\\\": b, \\\"% muestra\\\": (100 * b / b.sum()).round(2)})\\n\",\n",
    "    \"    print(title)\\n\",\n",
    "    \"    print(t.to_string(), \\\"\\\\n\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"tr_full = pd.read_csv(FEAT_DIR / \\\"features_train.csv\\\")\\n\",\n",
    "    \"va_full = pd.read_csv(FEAT_DIR / \\\"features_val.csv\\\")\\n\",\n",
    "    \"unknown = (set(tr_full[\\\"class\\\"]) | set(va_full[\\\"class\\\"])) - set(CLASSES)\\n\",\n",
    "    \"assert not unknown, f\\\"Clases en el CSV que no están en CLASSES: {unknown}\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"tr = stratified_subsample(tr_full, N_TRAIN, SEED)\\n\",\n",
    "    \"va = stratified_subsample(va_full, N_VAL, SEED)\\n\",\n",
    "    \"class_table(tr_full, tr, \\\"TRAIN\\\")\\n\",\n",
    "    \"class_table(va_full, va, \\\"VAL\\\")\\n\",\n",
    "    \"if tr[\\\"class\\\"].value_counts().min() < 3 * CV_FOLDS:\\n\",\n",
    "    \"    print(\\\"[aviso] alguna clase tiene muy pocas imágenes en train para una CV estable: sube N_TRAIN o baja CV_FOLDS\\\")\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"TRAIN\\n\",\n",
    "      \"       completo  % completo  muestra  % muestra\\n\",\n",
    "      \"class                                          \\n\",\n",
    "      \"bcc        1993       39.22     1993      39.22\\n\",\n",
    "      \"mel        2713       53.38     2713      53.38\\n\",\n",
    "      \"scc         376        7.40      376       7.40 \\n\",\n",
    "      \"\\n\",\n",
    "      \"VAL\\n\",\n",
    "      \"       completo  % completo  muestra  % muestra\\n\",\n",
    "      \"class                                          \\n\",\n",
    "      \"bcc         498       39.21      498      39.21\\n\",\n",
    "      \"mel         678       53.39      678      53.39\\n\",\n",
    "      \"scc          94        7.40       94       7.40 \\n\",\n",
    "      \"\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 2\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"cd214c57\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Features (solo columnas `shape_`, `color_`, `tex_`, `gcolor_`, `gtex_`; `qc_*`, `name`, `subtype`... no se usan)\\n\",\n",
    "    \"Se descartan las columnas casi vacías o constantes y las casi duplicadas (|r| > `CORR_THRESHOLD`); todo calculado solo con train.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"4656f4ef\",\n",
    "   \"metadata\": {\n",
    "    \"lines_to_next_cell\": 1,\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-21T06:32:57.719180900Z\",\n",
    "     \"start_time\": \"2026-10-21T06:32:57.273128200Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"def family_of(col):\\n\",\n",
    "    \"    for fam, p in PREFIX.items():\\n\",\n",
    "    \"        if col.startswith(p):\\n\",\n",
    "    \"            return fam\\n\",\n",
    "    \"    return None\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def drop_correlated(X, thr):\\n\",\n",
    "    \"    \\\"\\\"\\\"Quita (de forma voraz) las features con |correlación| >= thr con alguna ya conservada. Devuelve (keep, dropped).\\\"\\\"\\\"\\n\",\n",
    "    \"    A = SimpleImputer(strategy=\\\"median\\\").fit_transform(X.values.astype(np.float32))\\n\",\n",
    "    \"    C = np.nan_to_num(np.abs(np.corrcoef(A, rowvar=False)))\\n\",\n",
    "    \"    keep = []\\n\",\n",
    "    \"    for j in range(C.shape[0]):\\n\",\n",
    "    \"        if all(C[j, k] < thr for k in keep):\\n\",\n",
    "    \"            keep.append(j)\\n\",\n",
    "    \"    return [X.columns[j] for j in keep], [c for i, c in enumerate(X.columns) if i not in set(keep)]\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"feat_all = [c for c in tr.columns if family_of(c)]\\n\",\n",
    "    \"clean = lambda d: d[feat_all].replace([np.inf, -np.inf], np.nan)\\n\",\n",
    "    \"Xtr_raw, Xva_raw = clean(tr), clean(va)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# fuera: columnas casi vacías o constantes (calculado solo con train)\\n\",\n",
    "    \"dropped = [c for c in feat_all if Xtr_raw[c].notna().mean() < 0.5 or Xtr_raw[c].nunique() < 2]\\n\",\n",
    "    \"cand = [c for c in feat_all if c not in dropped and family_of(c) in USE_FAMILIES]\\n\",\n",
    "    \"dup = []\\n\",\n",
    "    \"if CORR_THRESHOLD:\\n\",\n",
    "    \"    cand, dup = drop_correlated(Xtr_raw[cand], CORR_THRESHOLD)\\n\",\n",
    "    \"feat = cand\\n\",\n",
    "    \"FAMILY = pd.Series({c: family_of(c) for c in feat})\\n\",\n",
    "    \"\\n\",\n",
    "    \"X_tr, X_va = Xtr_raw[feat].astype(np.float32), Xva_raw[feat].astype(np.float32)\\n\",\n",
    "    \"Xtr_np, Xva_np = X_tr.values, X_va.values\\n\",\n",
    "    \"y_tr = tr[\\\"class\\\"].map(CLASS_TO_LABEL).to_numpy()\\n\",\n",
    "    \"y_va = va[\\\"class\\\"].map(CLASS_TO_LABEL).to_numpy()\\n\",\n",
    "    \"K = len(CLASSES)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"{len(feat)} features usadas ({len(dropped)} vacías/constantes y {len(dup)} casi duplicadas descartadas)\\\")\\n\",\n",
    "    \"print(FAMILY.value_counts().to_string())\\n\",\n",
    "    \"print(f\\\"NaN medio: {100 * X_tr.isna().mean().mean():.2f}%\\\")\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"374 features usadas (0 vacías/constantes y 46 casi duplicadas descartadas)\\n\",\n",
    "      \"tex       83\\n\",\n",
    "      \"gtex      81\\n\",\n",
    "      \"shape     76\\n\",\n",
    "      \"color     71\\n\",\n",
    "      \"gcolor    63\\n\",\n",
    "      \"NaN medio: 0.00%\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 3\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"6b93a901\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Métricas (kappa = métrica principal) y ajuste de pesos por clase\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"0ea8fa63\",\n",
    "   \"metadata\": {\n",
    "    \"lines_to_next_cell\": 1,\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-21T06:32:57.754397100Z\",\n",
    "     \"start_time\": \"2026-10-21T06:32:57.723198600Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"def kappa(y, pred, weights=KAPPA_WEIGHTS):\\n\",\n",
    "    \"    \\\"\\\"\\\"Kappa de Cohen (sin pesos, o ponderado lineal / cuadrático). Calculado con la matriz de confusión (muy rápido).\\\"\\\"\\\"\\n\",\n",
    "    \"    cm = np.bincount(y * K + pred, minlength=K * K).reshape(K, K).astype(float)\\n\",\n",
    "    \"    n = cm.sum()\\n\",\n",
    "    \"    expected = np.outer(cm.sum(1), cm.sum(0)) / n\\n\",\n",
    "    \"    i, j = np.indices((K, K))\\n\",\n",
    "    \"    Wm = {None: 1.0 - np.eye(K), \\\"linear\\\": np.abs(i - j) / (K - 1), \\\"quadratic\\\": ((i - j) / (K - 1)) ** 2}[weights]\\n\",\n",
    "    \"    den = (Wm * expected).sum()\\n\",\n",
    "    \"    return 1.0 - (Wm * cm).sum() / den if den > 0 else 0.0\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def evaluate(y, P, w=None):\\n\",\n",
    "    \"    \\\"\\\"\\\"Métricas multiclase. P: probabilidades (n, K). w: multiplicadores por clase (None = argmax normal).\\\"\\\"\\\"\\n\",\n",
    "    \"    pred = (P * (np.ones(K) if w is None else w)).argmax(1)\\n\",\n",
    "    \"    Y = label_binarize(y, classes=np.arange(K))\\n\",\n",
    "    \"    prev = Y.mean(0)\\n\",\n",
    "    \"    ap = np.array([average_precision_score(Y[:, k], P[:, k]) for k in range(K)])\\n\",\n",
    "    \"    rec = recall_score(y, pred, average=None, labels=np.arange(K), zero_division=0)\\n\",\n",
    "    \"    out = {\\\"Kappa\\\": kappa(y, pred),                                    # MÉTRICA PRINCIPAL\\n\",\n",
    "    \"           \\\"F1 macro\\\": f1_score(y, pred, average=\\\"macro\\\", zero_division=0),\\n\",\n",
    "    \"           \\\"Bal. acc\\\": balanced_accuracy_score(y, pred),\\n\",\n",
    "    \"           \\\"MCC\\\": matthews_corrcoef(y, pred),\\n\",\n",
    "    \"           \\\"PR-AUC macro (info)\\\": ap.mean(),\\n\",\n",
    "    \"           \\\"PR-AUC norm (info)\\\": np.mean((ap - prev) / (1 - prev)),\\n\",\n",
    "    \"           \\\"ROC-AUC macro (info)\\\": roc_auc_score(Y, P, average=\\\"macro\\\"),\\n\",\n",
    "    \"           \\\"Accuracy (info)\\\": accuracy_score(y, pred)}\\n\",\n",
    "    \"    for k, c in enumerate(CLASSES):\\n\",\n",
    "    \"        out[f\\\"AP {c}\\\"] = ap[k]\\n\",\n",
    "    \"        out[f\\\"recall {c}\\\"] = rec[k]\\n\",\n",
    "    \"    return out\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def tune_class_weights(P, y, grid=np.exp(np.linspace(np.log(0.1), np.log(10), 21)), rounds=3):\\n\",\n",
    "    \"    \\\"\\\"\\\"Busca multiplicadores por clase (la clase 0 es la referencia) que maximizan el KAPPA de argmax(P * w).\\\"\\\"\\\"\\n\",\n",
    "    \"    f = lambda w: kappa(y, (P * w).argmax(1))\\n\",\n",
    "    \"    w = np.ones(K)\\n\",\n",
    "    \"    best = f(w)\\n\",\n",
    "    \"    for _ in range(rounds):\\n\",\n",
    "    \"        for k in range(1, K):\\n\",\n",
    "    \"            for g in grid:\\n\",\n",
    "    \"                w2 = w.copy()\\n\",\n",
    "    \"                w2[k] = g\\n\",\n",
    "    \"                s = f(w2)\\n\",\n",
    "    \"                if s > best + 1e-9:\\n\",\n",
    "    \"                    best, w = s, w2\\n\",\n",
    "    \"    return w / w.sum() * K\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def crossfit_kappa(P, y, seed=SEED + 1):\\n\",\n",
    "    \"    \\\"\\\"\\\"Kappa con pesos ajustados SIN optimismo: los pesos de cada trozo se ajustan con el resto de muestras OOF.\\\"\\\"\\\"\\n\",\n",
    "    \"    pred = np.empty(len(y), int)\\n\",\n",
    "    \"    for a, b in StratifiedKFold(CV_FOLDS, shuffle=True, random_state=seed).split(P, y):\\n\",\n",
    "    \"        pred[b] = (P[b] * tune_class_weights(P[a], y[a])).argmax(1)\\n\",\n",
    "    \"    return kappa(y, pred)\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 4\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"4ad6ecfa\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Modelos\\n\",\n",
    "    \"Cada modelo usa la versión de los datos que necesita: `sc` (imputada + cuantil, para logreg y SVM), `imp` (imputada, RF)\\n\",\n",
    "    \"o `raw` (con NaN; el boosting los gestiona solo). El preprocesado de cada fold se calcula **una vez** y lo comparten los modelos.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"8b4f3999\",\n",
    "   \"metadata\": {\n",
    "    \"lines_to_next_cell\": 1,\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-21T06:32:57.784990300Z\",\n",
    "     \"start_time\": \"2026-10-21T06:32:57.760618600Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"KIND = {\\\"logreg\\\": \\\"sc\\\", \\\"svm\\\": \\\"sc\\\", \\\"rf\\\": \\\"imp\\\", \\\"hgb\\\": \\\"raw\\\"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def make_model(name, rf_trees=RF_TREES):\\n\",\n",
    "    \"    if name == \\\"logreg\\\":\\n\",\n",
    "    \"        return LogisticRegression(C=0.05, class_weight=\\\"balanced\\\", max_iter=3000)\\n\",\n",
    "    \"    if name == \\\"svm\\\":\\n\",\n",
    "    \"        return SVC(C=1.0, kernel=\\\"rbf\\\", class_weight=\\\"balanced\\\", probability=SVM_PROBABILITY,\\n\",\n",
    "    \"                   decision_function_shape=\\\"ovr\\\", random_state=SEED)\\n\",\n",
    "    \"    if name == \\\"rf\\\":\\n\",\n",
    "    \"        return RandomForestClassifier(n_estimators=rf_trees, min_samples_leaf=2, max_features=\\\"sqrt\\\",\\n\",\n",
    "    \"                                      class_weight=\\\"balanced_subsample\\\", n_jobs=N_JOBS, random_state=SEED)\\n\",\n",
    "    \"    if name == \\\"hgb\\\":       # gestiona NaN solo; el desbalanceo se trata con pesos por muestra (ver fit_model)\\n\",\n",
    "    \"        return HistGradientBoostingClassifier(max_iter=300, learning_rate=0.05, max_leaf_nodes=15, min_samples_leaf=20,\\n\",\n",
    "    \"                                              l2_regularization=1.0, early_stopping=True, validation_fraction=0.15,\\n\",\n",
    "    \"                                              random_state=SEED)\\n\",\n",
    "    \"    raise ValueError(name)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def fit_model(name, X, y, rf_trees=RF_TREES):\\n\",\n",
    "    \"    m = make_model(name, rf_trees)\\n\",\n",
    "    \"    if name == \\\"hgb\\\":\\n\",\n",
    "    \"        m.fit(X, y, sample_weight=compute_sample_weight(\\\"balanced\\\", y))\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        m.fit(X, y)\\n\",\n",
    "    \"    return m\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def scores(name, m, X):\\n\",\n",
    "    \"    \\\"\\\"\\\"Probabilidades (n, K). El SVM sin probability=True devuelve un softmax de sus puntuaciones (no calibrado).\\\"\\\"\\\"\\n\",\n",
    "    \"    if name == \\\"svm\\\" and not SVM_PROBABILITY:\\n\",\n",
    "    \"        d = m.decision_function(X) * SVM_TEMP\\n\",\n",
    "    \"        e = np.exp(d - d.max(1, keepdims=True))\\n\",\n",
    "    \"        return e / e.sum(1, keepdims=True)\\n\",\n",
    "    \"    return m.predict_proba(X)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def fit_prep(Xa, kinds):\\n\",\n",
    "    \"    imp = SimpleImputer(strategy=\\\"median\\\").fit(Xa)\\n\",\n",
    "    \"    qt = None\\n\",\n",
    "    \"    if \\\"sc\\\" in kinds:\\n\",\n",
    "    \"        qt = QuantileTransformer(n_quantiles=200, output_distribution=\\\"normal\\\", random_state=SEED).fit(imp.transform(Xa))\\n\",\n",
    "    \"    return imp, qt\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def apply_prep(prep, X, kinds):\\n\",\n",
    "    \"    imp, qt = prep\\n\",\n",
    "    \"    out = {\\\"raw\\\": X}\\n\",\n",
    "    \"    if kinds & {\\\"imp\\\", \\\"sc\\\"}:\\n\",\n",
    "    \"        out[\\\"imp\\\"] = imp.transform(X)\\n\",\n",
    "    \"        if \\\"sc\\\" in kinds:\\n\",\n",
    "    \"            out[\\\"sc\\\"] = qt.transform(out[\\\"imp\\\"])\\n\",\n",
    "    \"    return out\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def make_folds(X, y, kinds):\\n\",\n",
    "    \"    \\\"\\\"\\\"Preprocesa cada fold UNA vez (con los datos de entrenamiento de ese fold).\\\"\\\"\\\"\\n\",\n",
    "    \"    folds = []\\n\",\n",
    "    \"    for a, b in StratifiedKFold(CV_FOLDS, shuffle=True, random_state=SEED).split(X, y):\\n\",\n",
    "    \"        prep = fit_prep(X[a], kinds)\\n\",\n",
    "    \"        folds.append((a, b, apply_prep(prep, X[a], kinds), apply_prep(prep, X[b], kinds)))\\n\",\n",
    "    \"    return folds\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def oof_from_folds(name, folds, y, rf_trees=RF_TREES):\\n\",\n",
    "    \"    \\\"\\\"\\\"Probabilidades out-of-fold: cada muestra se predice con un modelo que no la ha visto.\\\"\\\"\\\"\\n\",\n",
    "    \"    def job(a, b, da, db):\\n\",\n",
    "    \"        m = fit_model(name, da[KIND[name]], y[a], rf_trees)\\n\",\n",
    "    \"        return b, scores(name, m, db[KIND[name]])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # el SVM usa un solo núcleo por modelo: sus folds van en paralelo (hilos; libsvm libera el GIL).\\n\",\n",
    "    \"    # RF, boosting y regresión logística ya usan varios núcleos por dentro: folds en serie.\\n\",\n",
    "    \"    res = (Parallel(n_jobs=min(N_JOBS, len(folds)), backend=\\\"threading\\\")(delayed(job)(*f) for f in folds)\\n\",\n",
    "    \"           if name == \\\"svm\\\" else [job(*f) for f in folds])\\n\",\n",
    "    \"    P = np.zeros((len(y), K))\\n\",\n",
    "    \"    for b, p in res:\\n\",\n",
    "    \"        P[b] = p\\n\",\n",
    "    \"    return P\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 5\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"b2915137\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-21T06:37:42.195408Z\",\n",
    "     \"start_time\": \"2026-10-21T06:32:57.788500900Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"SIG = hashlib.md5(repr((feat, N_TRAIN, N_VAL, SEED, CV_FOLDS, RF_TREES, SVM_PROBABILITY, SVM_TEMP,\\n\",\n",
    "    \"                        len(y_tr), len(y_va))).encode()).hexdigest()[:10]\\n\",\n",
    "    \"CACHE_DIR.mkdir(parents=True, exist_ok=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"kinds_all = {KIND[n] for n in MODELS_TO_RUN}\\n\",\n",
    "    \"prep_full = fit_prep(Xtr_np, kinds_all)                             # preprocesado final: solo con train\\n\",\n",
    "    \"D_tr, D_va = apply_prep(prep_full, Xtr_np, kinds_all), apply_prep(prep_full, Xva_np, kinds_all)\\n\",\n",
    "    \"folds = None                                                         # se crean solo si algún modelo no está en caché\\n\",\n",
    "    \"\\n\",\n",
    "    \"P_oof, P_va, fitted = {}, {}, {}\\n\",\n",
    "    \"t_all = time.time()\\n\",\n",
    "    \"for name in MODELS_TO_RUN:\\n\",\n",
    "    \"    cache = CACHE_DIR / f\\\"{name}_{SIG}.joblib\\\"\\n\",\n",
    "    \"    if USE_CACHE and cache.exists():\\n\",\n",
    "    \"        c = joblib.load(cache)\\n\",\n",
    "    \"        P_oof[name], P_va[name], fitted[name] = c[\\\"P_oof\\\"], c[\\\"P_va\\\"], c[\\\"model\\\"]\\n\",\n",
    "    \"        print(f\\\"{name:7s} cargado de caché\\\")\\n\",\n",
    "    \"        continue\\n\",\n",
    "    \"    t0 = time.time()\\n\",\n",
    "    \"    if folds is None:\\n\",\n",
    "    \"        folds = make_folds(Xtr_np, y_tr, kinds_all)\\n\",\n",
    "    \"    P_oof[name] = oof_from_folds(name, folds, y_tr)\\n\",\n",
    "    \"    fitted[name] = fit_model(name, D_tr[KIND[name]], y_tr)\\n\",\n",
    "    \"    P_va[name] = scores(name, fitted[name], D_va[KIND[name]])\\n\",\n",
    "    \"    if USE_CACHE:\\n\",\n",
    "    \"        joblib.dump({\\\"P_oof\\\": P_oof[name], \\\"P_va\\\": P_va[name], \\\"model\\\": fitted[name]}, cache)\\n\",\n",
    "    \"    print(f\\\"{name:7s} listo en {time.time() - t0:.0f}s   (CV kappa argmax = {kappa(y_tr, P_oof[name].argmax(1)):.3f})\\\")\\n\",\n",
    "    \"print(f\\\"Total: {time.time() - t_all:.0f}s\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"members = list(MODELS_TO_RUN)\\n\",\n",
    "    \"if USE_ENSEMBLE and len(members) > 1:\\n\",\n",
    "    \"    P_oof[\\\"ensemble\\\"] = np.mean([P_oof[m] for m in members], axis=0)\\n\",\n",
    "    \"    P_va[\\\"ensemble\\\"] = np.mean([P_va[m] for m in members], axis=0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# línea base: predecir siempre las prevalencias de train (modelo sin información)\\n\",\n",
    "    \"prior = np.bincount(y_tr, minlength=K) / len(y_tr)\\n\",\n",
    "    \"P_oof[\\\"baseline\\\"] = np.tile(prior, (len(y_tr), 1))\\n\",\n",
    "    \"P_va[\\\"baseline\\\"] = np.tile(prior, (len(y_va), 1))\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"logreg  listo en 5s   (CV kappa argmax = 0.608)\\n\",\n",
    "      \"svm     listo en 10s   (CV kappa argmax = 0.678)\\n\",\n",
    "      \"rf      listo en 21s   (CV kappa argmax = 0.659)\\n\",\n",
    "      \"hgb     listo en 248s   (CV kappa argmax = 0.672)\\n\",\n",
    "      \"Total: 284s\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 6\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"816bbb53\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Resultados: CV en train (selección por **kappa**) y val (informe)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
