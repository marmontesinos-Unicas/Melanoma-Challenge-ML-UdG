    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"rf = fitted.get(\\\"rf\\\")\\n\",\n",
    "    \"if rf is None:\\n\",\n",
    "    \"    rf = fit_model(\\\"rf\\\", D_tr[\\\"imp\\\"] if \\\"imp\\\" in D_tr else apply_prep(prep_full, Xtr_np, {\\\"imp\\\"})[\\\"imp\\\"], y_tr)\\n\",\n",
    "    \"imp = pd.Series(rf.feature_importances_, index=feat).sort_values(ascending=False)\\n\",\n",
    "    \"\\n\",\n",
    "    \"colors = {\\\"shape\\\": \\\"tab:blue\\\", \\\"color\\\": \\\"tab:orange\\\", \\\"tex\\\": \\\"tab:green\\\", \\\"gcolor\\\": \\\"tab:red\\\", \\\"gtex\\\": \\\"tab:purple\\\"}\\n\",\n",
    "    \"top = imp.head(25)[::-1]\\n\",\n",
    "    \"fig, axs = plt.subplots(1, 2, figsize=(13, 6), gridspec_kw={\\\"width_ratios\\\": [3, 1]})\\n\",\n",
    "    \"axs[0].barh(top.index, top.values, color=[colors[FAMILY[c]] for c in top.index])\\n\",\n",
    "    \"axs[0].set(title=\\\"Top 25 features (importancia RF)\\\")\\n\",\n",
    "    \"fam_imp = imp.groupby(FAMILY).sum().sort_values()\\n\",\n",
    "    \"axs[1].barh(fam_imp.index, fam_imp.values, color=[colors[f] for f in fam_imp.index])\\n\",\n",
