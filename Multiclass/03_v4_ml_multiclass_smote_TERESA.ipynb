    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### ¿Hay overfitting? Train vs CV\\n\",\n",
    "    \"Rendimiento sobre el mismo train con el que se entrena cada fold frente al fold de validación (sale de la celda anterior,\\n\",\n",
    "    \"no se entrena nada nuevo). En Random Forest y XGBoost es normal que train esté cerca de 1.0; lo que manda es la CV.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-21T16:01:55.846353200Z\",\n",
    "     \"start_time\": \"2026-10-21T16:01:55.777302100Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"def train_vs_cv(raw):\\n\",\n",
    "    \"    g = raw.groupby(\\\"model\\\", sort=False)\\n\",\n",
    "    \"    t = pd.DataFrame({\\\"train_kappa\\\": g[\\\"train_kappa\\\"].mean(), \\\"cv_kappa\\\": g[\\\"kappa\\\"].mean(),\\n\",\n",
    "    \"                      \\\"train_bal_acc\\\": g[\\\"train_bal_acc\\\"].mean(), \\\"cv_bal_acc\\\": g[\\\"bal_acc\\\"].mean(),\\n\",\n",
    "    \"                      \\\"train_recall_scc\\\": g[\\\"train_recall_scc\\\"].mean(), \\\"cv_recall_scc\\\": g[\\\"recall_scc\\\"].mean()})\\n\",\n",
    "    \"    t.insert(2, \\\"gap_kappa\\\", t[\\\"train_kappa\\\"] - t[\\\"cv_kappa\\\"])\\n\",\n",
    "    \"    t.insert(5, \\\"gap_bal_acc\\\", t[\\\"train_bal_acc\\\"] - t[\\\"cv_bal_acc\\\"])\\n\",\n",
    "    \"    return t.sort_values(\\\"cv_kappa\\\", ascending=False).round(3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"ovf_all, ovf_top = train_vs_cv(raw_all), train_vs_cv(raw_top)\\n\",\n",
    "    \"print(f\\\"--- TODAS las features ({len(FEATS)}): train vs CV ---\\\")\\n\",\n",
    "    \"print(ovf_all.to_string(), \\\"\\\\n\\\")\\n\",\n",
    "    \"print(f\\\"--- TOP-{K_FEATURES}: train vs CV ---\\\")\\n\",\n",
    "    \"print(ovf_top.to_string())\\n\",\n",
    "    \"ovf_all.to_csv(OUT_DIR / \\\"train_vs_cv_all_features.csv\\\")\\n\",\n",
    "    \"ovf_top.to_csv(OUT_DIR / f\\\"train_vs_cv_top{K_FEATURES}.csv\\\")\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
