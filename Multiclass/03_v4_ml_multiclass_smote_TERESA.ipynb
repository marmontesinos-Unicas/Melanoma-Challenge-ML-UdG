    "      \"KNN                   0.487    0.710     0.600    0.884     0.705       0.612       0.677       0.840   0.829   0.934   0.353  [0.454, 0.524]\\n\",\n",
    "      \"Decision Tree         0.442    0.612     0.561    0.804     0.586       0.600       0.705       0.532   0.724   0.872   0.162  [0.406, 0.480]\\n\",\n",
