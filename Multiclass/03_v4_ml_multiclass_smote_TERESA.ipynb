    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 4. Evaluación final en val\\n\",\n",
    "    \"Se usa la variante de features (todas o top-K) que haya dado mejor kappa en la CV, sin mirar val. Cada modelo se entrena\\n\",\n",
    "    \"con **todo train** (en paralelo) y se evalúa una sola vez en val. El IC95 % del kappa sale de un bootstrap sobre val.\\n\",\n",
    "    \"El sampler solo sirve para entrenar, así que el pipeline final se guarda **sin** él (imputación → [top-K] →\\n\",\n",
    "    \"[escalado] → modelo). Predice exactamente igual y para cargarlo no hace falta `imblearn`.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-21T16:06:22.696100200Z\",\n",
    "     \"start_time\": \"2026-10-21T16:05:14.187631900Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"FINAL_K = None if res_all[\\\"_main\\\"].iloc[0] >= res_top[\\\"_main\\\"].iloc[0] else K_FEATURES\\n\",\n",
    "    \"res_cv = res_all if FINAL_K is None else res_top\\n\",\n",
    "    \"best = res_cv.index[0]                                  # mejor modelo según la CV (no según val)\\n\",\n",
    "    \"print(f\\\"Features para el modelo final: {'todas' if FINAL_K is None else f'top-{FINAL_K}'} | mejor en CV: {best}\\\\n\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def boot_ci(y, pred, fn=cohen_kappa_score, n=1000, seed=0):\\n\",\n",
    "    \"    rng = np.random.RandomState(seed)\\n\",\n",
    "    \"    vals = [fn(y[i], pred[i]) for i in (rng.choice(len(y), len(y), replace=True) for _ in range(n))]\\n\",\n",
    "    \"    return np.percentile(vals, [2.5, 97.5])\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"prep = make_prep(FINAL_K, n_jobs=N_JOBS).fit(Xtr, ytr)          # imputación (+ top-K) una sola vez\\n\",\n",
    "    \"Xtr_s, Xva_s = prep.transform(Xtr), prep.transform(Xva)\\n\",\n",
    "    \"heads = Parallel(n_jobs=N_JOBS)(delayed(fit_head)(est, scale, sw, Xtr_s, ytr) for est, scale, sw in MODELS.values())\\n\",\n",
    "    \"\\n\",\n",
    "    \"fitted, rows, probas, preds = {}, [], {}, {}\\n\",\n",
    "    \"for name, head in zip(MODELS, heads):\\n\",\n",
    "    \"    pipe = Pipeline(prep.steps + [s for s in head.steps if s[0] != \\\"sampler\\\"])   # ya entrenado, sin el sampler (acepta las 420 columnas)\\n\",\n",
    "    \"    P, pred = predict_scores(pipe, Xva), pipe.predict(Xva)\\n\",\n",
    "    \"    lo, hi = boot_ci(yva, pred)\\n\",\n",
    "    \"    fitted[name], probas[name], preds[name] = pipe, P, pred\\n\",\n",
    "    \"    rows.append({\\\"modelo\\\": name, **mc_metrics(yva, P, pred), \\\"kappa IC95%\\\": f\\\"[{lo:.3f}, {hi:.3f}]\\\"})\\n\",\n",
    "    \"val_res = pd.DataFrame(rows).set_index(\\\"modelo\\\").sort_values(\\\"kappa\\\", ascending=False)\\n\",\n",
    "    \"print(f\\\"Val ({len(Xva)} imágenes):\\\\n\\\")\\n\",\n",
    "    \"print(val_res.round(3).to_string())\\n\",\n",
    "    \"val_res.round(4).to_csv(OUT_DIR / \\\"val_results.csv\\\")\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
