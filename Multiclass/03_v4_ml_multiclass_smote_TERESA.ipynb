    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"ROOT: C:\\\\Users\\\\Lenovo\\\\PycharmProjects\\\\Melanoma-Challenge-ML-UdG\\n\",\n",
    "      \"cores: 8 -> N_JOBS = 6\\n\",\n",
    "      \"remuestreo: SMOTE(random_state=42, sampling_strategy='not majority')\\n\"\n",
    "     ]\n",
