    "    \"          f\\\"  error: {type(e).__name__}: {e}\\\\n  python del kernel: {sys.executable}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"warnings.filterwarnings(\\\"ignore\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ---------------- Configuración ----------------\\n\",\n",
    "    \"ROOT = Path(r\\\"C:\\\\Users\\\\Lenovo\\\\PycharmProjects\\\\Melanoma-Challenge-ML-UdG\\\")\\n\",\n",
    "    \"assert (ROOT / \\\"features_multiclass_final\\\").exists(), f\\\"ROOT incorrecta: {ROOT} (fíjala a mano arriba)\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"FEAT_DIR  = ROOT / \\\"features_multiclass_final\\\"\\n\",\n",
    "    \"TRAIN_CSV = FEAT_DIR / \\\"features_train.csv\\\"\\n\",\n",
    "    \"VAL_CSV   = FEAT_DIR / \\\"features_val.csv\\\"\\n\",\n",
    "    \"OUT_DIR   = ROOT / \\\"Multiclass\\\" / \\\"ml_results_multiclass_smote_final\\\"   # carpeta propia: no pisa los resultados anteriores   # carpeta propia: no pisa los resultados de los otros notebooks\\n\",\n",
    "    \"CLASSES = [\\\"bcc\\\", \\\"mel\\\", \\\"scc\\\"]          # orden de las etiquetas 0, 1, 2\\n\",\n",
    "    \"K_FEATURES = 50                          # top-K para la variante con selección\\n\",\n",
    "    \"CV_FOLDS = 5\\n\",\n",
    "    \"SEED = 42\\n\",\n",
    "    \"N_JOBS = max(1, (os.cpu_count() or 1) - 2)          # todos los cores disponibles menos 2\\n\",\n",
    "    \"\\n\",\n",
    "    \"RESAMPLING = \\\"SMOTE\\\"\\n\",\n",
    "    \"SAMPLER = SMOTE(sampling_strategy=\\\"not majority\\\", k_neighbors=5, random_state=SEED)   # BCC y SCC hasta igualar a MEL\\n\",\n",
    "    \"SCALE_ALL = True                                   # True: transformación cuantil en todos los modelos, antes del sampler\\n\",\n",
    "    \"OUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\n",
    "    \"print(f\\\"ROOT: {ROOT}\\\\ncores: {os.cpu_count()} -> N_JOBS = {N_JOBS}\\\\nremuestreo: {SAMPLER}\\\")\"\n",
    "   ],\n",
