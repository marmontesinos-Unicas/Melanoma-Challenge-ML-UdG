    "    \"from sklearn.utils.class_weight import compute_sample_weight\\n\",\n",
    "    \"\\n\",\n",
    "    \"try:\\n\",\n",
    "    \"    from imblearn.over_sampling import SMOTE\\n\",\n",
    "    \"    from imblearn.pipeline import Pipeline as ImbPipeline     # aplica el sampler solo al entrenar (fit), nunca al predecir\\n\",\n",
    "    \"except ImportError as e:\\n\",\n",
    "    \"    raise ImportError(\\\"Falta imbalanced-learn: pip install imbalanced-learn (en el entorno del kernel)\\\") from e\\n\",\n",
    "    \"\\n\",\n",
    "    \"try:\\n\",\n",
