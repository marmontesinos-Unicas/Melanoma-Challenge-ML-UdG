    "    \"    ap = average_precision_score(Yva[:, j], probas[name][:, j])\\n\",\n",
    "    \"    axs[1].plot(rec, prec, lw=2 if name == best else 1, label=f\\\"{name} (AP {ap:.3f})\\\")\\n\",\n",
    "    \"axs[1].axhline(Yva[:, j].mean(), color=\\\"k\\\", ls=\\\"--\\\", lw=0.8, label=f\\\"azar = prevalencia ({Yva[:, j].mean():.3f})\\\")\\n\",\n",
    "    \"axs[1].set(xlabel=\\\"recall\\\", ylabel=\\\"precisión\\\", title=\\\"SCC: todos los modelos\\\", xlim=(0, 1), ylim=(0, 1.02))\\n\",\n",
    "    \"axs[1].legend(fontsize=8, loc=\\\"upper right\\\")\\n\",\n",
