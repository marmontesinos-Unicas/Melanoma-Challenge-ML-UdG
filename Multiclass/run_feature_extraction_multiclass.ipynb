   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# Feature extraction (multiclass: shape, color, texture)\\n\",\n",
    "    \"\\n\",\n",
    "    \"Reads `manifest.csv` from `PROC_DIR` and, for each image, loads `_preprocessed.png` (no blur) and `_mask.png`.\\n\",\n",
    "    \"Saves **one CSV per split** (`features_train.csv` and `features_val.csv`) in `OUT_DIR`.\\n\",\n",
    "    \"\\n\",\n",
    "    \"All the functions live in `features/features.py`. The feature parameters\\n\",\n",
    "    \"(`KMEANS_K`, `RIDGE_THR`, `EXTENDED_SHAPE`, Gabor...) are changed there; this notebook only holds the paths and the execution.\\n\",\n",
    "    \"\\n\",\n",
    "    \"- The **first column is `name`**. Then: `class`, `subtype`, `label` and two quality flags `qc_*` (not features: do not use them for training).\\n\",\n",
    "    \"- Prefixes `shape_` (52), `color_` (82) and `tex_` (104, includes LNDP and Gabor) are computed **inside the lesion only**;\\n\",\n",
    "    \"  `gcolor_` (70) and `gtex_` (104) are computed over the **whole image**. Expected total: **412 features**.\\n\",\n",
    "    \"- If the mask is empty or a family fails, those columns are left as NaN (the whole-image ones are still computed).\"\n",
    "   ],\n",
    "   \"id\": \"790058fa8e65da01\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-21T15:00:21.133683200Z\",\n",
    "     \"start_time\": \"2026-10-21T15:00:08.804091100Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"import sys\\n\",\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"from joblib import Parallel, delayed\\n\",\n",
    "    \"from tqdm.auto import tqdm\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ---------------- Configuration ----------------\\n\",\n",
    "    \"ROOT = Path(r\\\"C:\\\\Users\\\\Lenovo\\\\PycharmProjects\\\\Melanoma-Challenge-ML-UdG\\\")\\n\",\n",
    "    \"PROC_DIR = ROOT / \\\"preprocessed_multiclass\\\"          # <-- folder with the multiclass preprocessing manifest.csv (adjust it)\\n\",\n",
    "    \"OUT_DIR = ROOT / \\\"features_multiclass_final\\\"         # new folder so the previous CSVs are not overwritten\\n\",\n",
    "    \"N_JOBS = 4                                           # cores (-1 = all, -2 = all but one)\\n\",\n",
    "    \"LIMIT = None                                         # e.g. 20 to test with a few images per split; None = all\\n\",\n",
    "    \"CLASS_TO_LABEL = None                                # None = automatic (classes sorted alphabetically -> 0, 1, 2...); or a dict by hand\\n\",\n",
    "    \"N_SHOW = 4                                           # example images per class\\n\",\n",
    "    \"\\n\",\n",
    "    \"sys.path.insert(0, str(ROOT / \\\"features\\\"))           # folder where features.py lives\\n\",\n",
    "    \"import features as F\\n\",\n",
    "    \"assert hasattr(F, \\\"extract_one\\\"), \\\"The 'features' package was imported instead of features.py: restart the kernel.\\\"\"\n",
    "   ],\n",
    "   \"id\": \"c76bf94c0751c605\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 1\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-21T15:00:21.293384500Z\",\n",
    "     \"start_time\": \"2026-10-21T15:00:21.135316400Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"manifest_path = PROC_DIR / \\\"manifest.csv\\\"\\n\",\n",
    "    \"if not manifest_path.exists():\\n\",\n",
    "    \"    found = [str(p) for p in ROOT.glob(\\\"*/manifest.csv\\\")] + [str(p) for p in ROOT.glob(\\\"Multiclass/*/manifest.csv\\\")]\\n\",\n",
    "    \"    raise FileNotFoundError(f\\\"{manifest_path} does not exist. Manifests found: {found}. Set PROC_DIR by hand.\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"manifest = pd.read_csv(manifest_path)\\n\",\n",
    "    \"manifest = manifest[manifest[\\\"status\\\"].isin([\\\"ok\\\", \\\"skipped\\\"])].reset_index(drop=True)\\n\",\n",
    "    \"if LIMIT:\\n\",\n",
    "    \"    manifest = manifest.groupby(\\\"split\\\").head(LIMIT).reset_index(drop=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"if CLASS_TO_LABEL is None:\\n\",\n",
    "    \"    CLASS_TO_LABEL = {c: i for i, c in enumerate(sorted(manifest[\\\"class\\\"].unique()))}\\n\",\n",
    "    \"print(\\\"processed:\\\", PROC_DIR)\\n\",\n",
    "    \"print(\\\"class -> label:\\\", CLASS_TO_LABEL)\\n\",\n",
    "    \"print(manifest.groupby([\\\"split\\\", \\\"class\\\"]).size().to_string())\"\n",
    "   ],\n",
    "   \"id\": \"702d1b3f450fce83\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"processed: C:\\\\Users\\\\Lenovo\\\\PycharmProjects\\\\Melanoma-Challenge-ML-UdG\\\\preprocessed_multiclass\\n\",\n",
    "      \"class -> label: {'bcc': 0, 'mel': 1, 'scc': 2}\\n\",\n",
    "      \"split  class\\n\",\n",
    "      \"train  bcc      1993\\n\",\n",
    "      \"       mel      2713\\n\",\n",
    "      \"       scc       376\\n\",\n",
    "      \"val    bcc       498\\n\",\n",
    "      \"       mel       678\\n\",\n",
    "      \"       scc        94\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 2\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Example images per class (green contour = mask)\"\n",
    "   ],\n",
    "   \"id\": \"13271ddba2d4c2c0\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-21T15:00:22.854280700Z\",\n",
    "     \"start_time\": \"2026-10-21T15:00:21.309384500Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"import cv2\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"\\n\",\n",
    "    \"classes = sorted(manifest[\\\"class\\\"].unique())\\n\",\n",
    "    \"fig, axes = plt.subplots(len(classes), N_SHOW, figsize=(2.6 * N_SHOW, 2.8 * len(classes)), squeeze=False)\\n\",\n",
    "    \"for ci, c in enumerate(classes):\\n\",\n",
    "    \"    sub = manifest[manifest[\\\"class\\\"] == c]\\n\",\n",
    "    \"    sample = sub.sample(min(N_SHOW, len(sub)), random_state=0)\\n\",\n",
    "    \"    for j in range(N_SHOW):\\n\",\n",
    "    \"        ax = axes[ci, j]\\n\",\n",
    "    \"        ax.axis(\\\"off\\\")\\n\",\n",
    "    \"        if j >= len(sample):\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"        r = sample.iloc[j]\\n\",\n",
    "    \"        img, mask = F.read_rgb(r[\\\"preprocessed\\\"]), F.read_mask(r[\\\"mask\\\"])\\n\",\n",
    "    \"        cnts, _ = cv2.findContours(mask.astype(np.uint8), cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\\n\",\n",
    "    \"        ax.imshow(cv2.drawContours(img.copy(), cnts, -1, (0, 255, 0), 2))\\n\",\n",
    "    \"        ax.set_title(f\\\"{c}\\\\n{r['subtype']}\\\", fontsize=8)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\"\n",
    "   ],\n",
    "   \"id\": \"e8c561532d2db4c0\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"<Figure size 1040x840 with 12 Axes>\"\n",
    "      ],\n",
    "      \"image/png\": \"\"\n",
    "     },\n",
    "     \"metadata\": {},\n",
    "     \"output_type\": \"display_data\",\n",
    "     \"jetTransient\": {\n",
    "      \"display_id\": null\n",
    "     }\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 3\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Extraction (parallel)\"\n",
    "   ],\n",
    "   \"id\": \"7da1ff14a27fd530\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-21T15:47:33.737549200Z\",\n",
    "     \"start_time\": \"2026-10-21T15:00:22.872277800Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"gen = Parallel(n_jobs=N_JOBS, return_as=\\\"generator\\\")(\\n\",\n",
    "    \"    delayed(F.extract_one)(r, CLASS_TO_LABEL) for r in manifest.to_dict(\\\"records\\\"))\\n\",\n",
    "    \"df = pd.DataFrame([r for r in tqdm(gen, total=len(manifest))])\\n\",\n",
    "    \"\\n\",\n",
    "    \"meta = [\\\"name\\\", \\\"class\\\", \\\"subtype\\\", \\\"label\\\", \\\"qc_seg_ok\\\", \\\"qc_crop_fallback\\\"]\\n\",\n",
    "    \"feat_cols = [c for p in F.FEATURE_PREFIXES for c in df.columns if c.startswith(p)]\\n\",\n",
    "    \"df = df[meta + feat_cols + [\\\"qc_errors\\\"]]\\n\",\n",
    "    \"df[\\\"_split\\\"] = df[\\\"name\\\"].map(manifest.set_index(\\\"name\\\")[\\\"split\\\"])\\n\",\n",
    "    \"print(f\\\"\\\\n{df.shape[0]} images, {len(feat_cols)} features\\\")\"\n",
    "   ],\n",
    "   \"id\": \"47e0d5fd30959953\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"  0%|          | 0/6352 [00:00<?, ?it/s]\"\n",
    "      ],\n",
    "      \"application/vnd.jupyter.widget-view+json\": {\n",
    "       \"version_major\": 2,\n",
    "       \"version_minor\": 0,\n",
    "       \"model_id\": \"4f0405ba55594864a3c126605e647dee\"\n",
    "      }\n",
    "     },\n",
    "     \"metadata\": {},\n",
    "     \"output_type\": \"display_data\",\n",
    "     \"jetTransient\": {\n",
    "      \"display_id\": null\n",
    "     }\n",
    "    },\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"\\n\",\n",
    "      \"6352 images, 412 features\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 4\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Saving: one CSV per split\"\n",
    "   ],\n",
    "   \"id\": \"457057bd5f8d272a\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-21T15:47:36.327750100Z\",\n",
    "     \"start_time\": \"2026-10-21T15:47:33.749546300Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"OUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\n",
    "    \"import json\\n\",\n",
    "    \"(OUT_DIR / \\\"class_to_label.json\\\").write_text(json.dumps(CLASS_TO_LABEL, indent=1, ensure_ascii=False), encoding=\\\"utf-8\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"for split in [\\\"train\\\", \\\"val\\\"]:\\n\",\n",
    "    \"    part = df[df[\\\"_split\\\"] == split].drop(columns=\\\"_split\\\")\\n\",\n",
    "    \"    if len(part) == 0:\\n\",\n",
    "    \"        continue\\n\",\n",
    "    \"    path = OUT_DIR / f\\\"features_{split}.csv\\\"\\n\",\n",
    "    \"    part.to_csv(path, index=False)\\n\",\n",
    "    \"    print(f\\\"{path}  ->  {part.shape[0]} rows x {part.shape[1]} columns\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# per-family summary (expected: shape 52, color 82, tex 104, gcolor 70, gtex 104)\\n\",\n",
    "    \"nan_pct = df[feat_cols].isna().mean()\\n\",\n",
    "    \"for p in [\\\"shape\\\", \\\"color\\\", \\\"tex\\\", \\\"gcolor\\\", \\\"gtex\\\"]:\\n\",\n",
    "    \"    cols_p = [c for c in feat_cols if c.startswith(p + \\\"_\\\")]\\n\",\n",
    "    \"    if cols_p:\\n\",\n",
    "    \"        print(f\\\"{p:6s} {len(cols_p):3d} columns | mean NaN: {100 * nan_pct[cols_p].mean():.2f}%\\\")\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        print(f\\\"{p:6s}   0 columns  <-- the family failed on every image! check qc_errors\\\")\\n\",\n",
    "    \"bad = df[df[\\\"qc_errors\\\"] != \\\"\\\"]\\n\",\n",
    "    \"print(f\\\"Images with some error: {len(bad)}\\\")\\n\",\n",
    "    \"if len(bad):\\n\",\n",
    "    \"    print(bad[\\\"qc_errors\\\"].str.split(\\\";\\\").explode().str.replace(r\\\"^(\\\\w+:\\\\w+@\\\\w+:L\\\\d+).*\\\", r\\\"\\\\1\\\", regex=True)\\n\",\n",
    "    \"          .value_counts().head(10).to_string())          # most frequent errors (type, function and line)\\n\",\n",
    "    \"    print(bad[[\\\"name\\\", \\\"qc_errors\\\"]].head(5).to_string(index=False))\"\n",
    "   ],\n",
    "   \"id\": \"1bf76cc2122a8181\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"C:\\\\Users\\\\Lenovo\\\\PycharmProjects\\\\Melanoma-Challenge-ML-UdG\\\\features_multiclass_final\\\\features_train.csv  ->  5082 rows x 419 columns\\n\",\n",
    "      \"C:\\\\Users\\\\Lenovo\\\\PycharmProjects\\\\Melanoma-Challenge-ML-UdG\\\\features_multiclass_final\\\\features_val.csv  ->  1270 rows x 419 columns\\n\",\n",
    "      \"shape   52 columns | mean NaN: 0.00%\\n\",\n",
    "      \"color   82 columns | mean NaN: 0.00%\\n\",\n",
    "      \"tex    104 columns | mean NaN: 0.00%\\n\",\n",
    "      \"gcolor  70 columns | mean NaN: 0.00%\\n\",\n",
    "      \"gtex   104 columns | mean NaN: 0.00%\\n\",\n",
    "      \"Images with some error: 0\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 5\n",
    "  }\n",
